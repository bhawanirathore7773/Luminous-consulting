generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Service {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(120)
  slug               String   @unique @db.VarChar(140)
  shortSummary       String   @map("short_summary") @db.VarChar(200)
  heroIntro          String   @map("hero_intro") @db.Text
  businessProblem    String   @map("business_problem") @db.Text
  deliveryApproach   String   @map("delivery_approach") @db.Text
  engagementModel    String   @map("engagement_model") @db.Text
  whoItsFor          String   @map("who_its_for") @db.Text
  ctaLabel           String   @map("cta_label") @db.VarChar(80)
  metaTitle          String?  @map("meta_title") @db.VarChar(70)
  metaDescription    String?  @map("meta_description") @db.VarChar(160)
  featured           Boolean  @default(false)
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  listItems          ServiceListItem[]
  faqs               Faq[]
  relatedFrom        ServiceRelation[] @relation("ServiceRelationFrom")
  relatedTo          ServiceRelation[] @relation("ServiceRelationTo")
  caseStudyRelations CaseStudyServiceRelation[]

  @@index([featured, sortOrder])
  @@map("services")
}

model ServiceListItem {
  id        Int     @id @default(autoincrement())
  serviceId Int     @map("service_id")
  section   String  @db.VarChar(40)
  text      String  @db.VarChar(300)
  sortOrder Int     @default(0) @map("sort_order")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, section, sortOrder])
  @@map("service_list_items")
}

model ServiceRelation {
  fromId Int @map("from_id")
  toId   Int @map("to_id")

  from Service @relation("ServiceRelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Service @relation("ServiceRelationTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@map("service_relations")
}

model Industry {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(120)
  slug           String   @unique @db.VarChar(140)
  shortSummary   String   @map("short_summary") @db.VarChar(200)
  heroIntro      String   @map("hero_intro") @db.Text
  sapLandscape   String   @map("sap_landscape") @db.Text
  outcomes       String   @db.Text
  ctaLabel       String   @map("cta_label") @db.VarChar(80)
  metaTitle      String?  @map("meta_title") @db.VarChar(70)
  metaDescription String? @map("meta_description") @db.VarChar(160)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  listItems IndustryListItem[]
  caseStudies CaseStudy[]
  serviceRelations IndustryServiceRelation[]
  faqs Faq[]

  @@map("industries")
}

model IndustryListItem {
  id         Int    @id @default(autoincrement())
  industryId Int    @map("industry_id")
  section    String @db.VarChar(40)
  text       String @db.VarChar(300)
  sortOrder  Int    @default(0) @map("sort_order")

  industry Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@index([industryId, section, sortOrder])
  @@map("industry_list_items")
}

model IndustryServiceRelation {
  industryId Int @map("industry_id")
  serviceId  Int @map("service_id")

  industry Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)
  service  Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([industryId, serviceId])
  @@map("industry_service_relations")
}

model Solution {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(120)
  slug            String   @unique @db.VarChar(140)
  shortSummary    String   @map("short_summary") @db.VarChar(200)
  heroIntro       String   @map("hero_intro") @db.Text
  businessProblem String   @map("business_problem") @db.Text
  ctaLabel        String   @map("cta_label") @db.VarChar(80)
  metaTitle       String?  @map("meta_title") @db.VarChar(70)
  metaDescription String?  @map("meta_description") @db.VarChar(160)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  listItems        SolutionListItem[]
  serviceRelations SolutionServiceRelation[]
  relatedFrom      SolutionRelation[] @relation("SolutionRelationFrom")
  relatedTo        SolutionRelation[] @relation("SolutionRelationTo")
  faqs             Faq[]

  @@map("solutions")
}

model SolutionListItem {
  id         Int      @id @default(autoincrement())
  solutionId Int      @map("solution_id")
  section    String   @db.VarChar(40)
  text       String   @db.VarChar(300)
  sortOrder  Int      @default(0) @map("sort_order")

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@index([solutionId, section, sortOrder])
  @@map("solution_list_items")
}

model SolutionRelation {
  fromId Int @map("from_id")
  toId   Int @map("to_id")

  from Solution @relation("SolutionRelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Solution @relation("SolutionRelationTo", fields: [toId], references: [id], onDelete: Cascade)

  @@id([fromId, toId])
  @@map("solution_relations")
}

model SolutionServiceRelation {
  solutionId Int @map("solution_id")
  serviceId  Int @map("service_id")

  solution Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([solutionId, serviceId])
  @@map("solution_service_relations")
}

model CaseStudy {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(180)
  slug            String   @unique @db.VarChar(200)
  industry        String   @db.VarChar(120)
  shortSummary    String   @map("short_summary") @db.Text
  label            String?  @db.VarChar(180)
  content         String   @db.LongText
  metaTitle       String?  @map("meta_title") @db.VarChar(70)
  metaDescription String?  @map("meta_description") @db.VarChar(160)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("case_studies")
}

model Article {
  id              Int      @id @default(autoincrement())
  title           String   @db.VarChar(200)
  slug            String   @unique @db.VarChar(220)
  summary         String   @db.VarChar(250)
  author          String   @default("SAP Practice Team") @db.VarChar(120)
  publishedDate   DateTime @default(now()) @map("published_date")
  category        String   @db.VarChar(40)
  contentType     String   @map("content_type") @db.VarChar(40)
  content         String   @db.LongText
  ctaLabel        String   @map("cta_label") @db.VarChar(80)
  metaTitle       String?  @map("meta_title") @db.VarChar(70)
  metaDescription String? @map("meta_description") @db.VarChar(160)
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([category, publishedDate])
  relatedServiceLinks ArticleServiceRelation[]
  relatedArticleFrom ArticleRelation[] @relation("ArticleRelationFrom")
  relatedArticleTo ArticleRelation[] @relation("ArticleRelationTo")

  @@map("articles")
}

model ArticleServiceRelation {
  articleId Int @map("article_id")
  serviceId Int @map("service_id")
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@id([articleId, serviceId])
  @@map("article_service_relations")
}

model ArticleRelation {
  fromId Int @map("from_id")
  toId Int @map("to_id")
  from Article @relation("ArticleRelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to Article @relation("ArticleRelationTo", fields: [toId], references: [id], onDelete: Cascade)
  @@id([fromId, toId])
  @@map("article_relations")
}

model ExpertiseItem {
  id          Int      @id @default(autoincrement())
  category    String   @db.VarChar(40)
  name        String   @db.VarChar(100)
  description String   @default("") @db.VarChar(200)
  sortOrder   Int      @default(0) @map("sort_order")

  @@index([category, sortOrder])
  @@map("expertise_items")
}

model TeamMember {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(120)
  role           String   @db.VarChar(120)
  category       String   @db.VarChar(30)
  expertise      String   @db.Text
  modules        String   @db.VarChar(200)
  technologies   String   @db.VarChar(200)
  industries     String   @db.VarChar(200)
  certifications String   @db.VarChar(300)
  sortOrder      Int      @default(0) @map("sort_order")

  @@index([category, sortOrder])
  @@map("team_members")
}

model Lead {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(120)
  workEmail        String   @map("work_email") @db.VarChar(255)
  company          String   @db.VarChar(150)
  jobTitle         String?  @map("job_title") @db.VarChar(120)
  country          String?  @db.VarChar(100)
  phone            String?  @db.VarChar(40)
  sapEnvironment   String?  @map("sap_environment") @db.VarChar(30)
  currentSapSystem String?  @map("current_sap_system") @db.VarChar(200)
  requiredServices String?  @map("required_services") @db.VarChar(300)
  projectStage     String?  @map("project_stage") @db.VarChar(30)
  timeline         String?  @db.VarChar(30)
  estimatedScope   String?  @map("estimated_scope") @db.VarChar(30)
  message          String?  @db.LongText
  source           String   @default("contact_page") @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("leads")
}

model LegalPage {
  id              Int      @id @default(autoincrement())
  slug            String   @unique @db.VarChar(100)
  title           String   @db.VarChar(200)
  content         String   @db.LongText
  metaTitle       String?  @map("meta_title") @db.VarChar(70)
  metaDescription String? @map("meta_description") @db.VarChar(160)

  @@map("legal_pages")
}

model Faq {
  id            Int      @id @default(autoincrement())
  targetType    String   @map("target_type") @db.VarChar(40)
  targetId      Int      @map("target_id")
  question      String   @db.VarChar(255)
  answer        String   @db.Text
  sortOrder     Int      @default(0) @map("sort_order")

  @@index([targetType, targetId, sortOrder])
  @@map("faqs")
}
